# NODE 51 — variables d'environnement
# Copie ce fichier en .env.local puis renseigne tes valeurs (ne jamais committer .env.local).

# --- Supabase (obligatoire pour enregistrer les contacts) ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "service_role" (SECRET, serveur uniquement — ne jamais l'exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (optionnel : email de notification à chaque contact) ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur (doit être un domaine/adresse vérifié dans Resend)
RESEND_FROM_EMAIL=NODE 51 <no-reply@node51.io>
# Destinataire des notifications internes
CONTACT_NOTIFICATION_EMAIL=contact@node51.io

# --- Admin (page /admin protégée par Basic Auth) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Newsletter (optionnel) ---
# Secret pour signer les liens de désinscription (/desinscription).
# Si vide, la clé service_role est utilisée. Défini-le pour pouvoir la faire tourner sans invalider les creds Supabase.
NEWSLETTER_SECRET=

# --- Session admin (optionnel) ---
# Secret pour signer le cookie de session /admin. Si vide, la clé service_role est utilisée.
# Le changer déconnecte tout le monde.
SESSION_SECRET=

